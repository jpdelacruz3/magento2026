# ── App ───────────────────────────────────────────────────────────────────────
MAGENTO_BASE_URL=http://magentoclaude.local/

# ── Database ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=magento
MYSQL_USER=magento
MYSQL_PASSWORD=magento_secret

# ── Database connection (used by PHP-FPM / Magento installer) ─────────────────
MAGENTO_DB_HOST=db
MAGENTO_DB_PORT=3306

# ── Elasticsearch ─────────────────────────────────────────────────────────────
MAGENTO_ES_HOST=elasticsearch
MAGENTO_ES_PORT=9200
